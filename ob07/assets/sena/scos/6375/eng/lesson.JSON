lesson"}, {"content": "B2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe ways of solving problems and getting things done in work and social contexts.", "type": "primary"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_1"}, {"content": "Understands specific information in written texts about the different social and work contexts.", "type": "secondary_2"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_3"}, {"content": "Understands specific information in written texts about the different social and work contexts.", "type": "secondary_4"}, {"content": "Understands specific information in written texts about the different social and work contexts.", "type": "secondary_5"}, {"content": "Understands specific information in written texts about the different social and work contexts.", "type": "secondary_6"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_7"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_8"}]}, {"content": "engenn9le01ob07re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "<span class=\"italic\">Need</span> + Passive Infinitive and Need + Verb + ing", "type": "heading"}, {"content": "<span class=\"strong\"><span class=\"italic\">Need</span> + passive infinitive</span> and <span class=\"strong\"><span class=\"italic\">need</span> + verb + <span class=\"italic\">ing</span></span> are two structures you use to talk about fixing problems. You use these structures to imply that we don't know who will fix the problem, or that the person fixing the problem is not the focus of the sentence. Note the difference in structure.", "type": "describer"}, {"content": "<span class=\"italic\">I need to call pest control.</span><br/>In the sentence above I will do the calling. This is an ACTIVE sentence.", "type": "text"}, {"content": "<span class=\"italic\">Pest control needs to be called.</span><br/>In this sentence we don't know who will do the calling. This is a PASSIVE sentence.", "type": "text"}, {"content": "<span class=\"italic\">Pest control needs calling.</span><br/>This sentence has the same meaning as the sentence above. It is also PASSIVE.", "type": "text"}, {"content": "It will need to be dealt with soon.", "type": "example"}, {"content": "Do you really think pest control needs to be called?", "type": "example"}, {"content": "They need to be kept short and sharp.", "type": "example"}, {"content": "So many things need fixing! ", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Simple Present", "type": "heading"}, {"content": "You use the simple present to talk about facts or states. You also use the simple present with linking or stative verbs.", "type": "describer"}, {"content": "<span class=\"underline\">Simple Present showing Fact</span><br/><span class=\"italic\">Squirrels <span class=\"strong\">have</span> front teeth that keep growing.</span>", "type": "text"}, {"content": "<span class=\"underline\">Simple Present with a Stative Verb</span><br/> <span class=\"italic\">It <span class=\"strong\">sounds</span> like it's coming from inside the house.</span>", "type": "text"}, {"content": "\u2018<span class=\"strong\">Sounds</span>' is a  verb that shows perception in the example sentence above.", "type": "text"}, {"content": "Note: It can also be used in an active sense but the meaning is different.<br/><span class=\"italic\">She <span class=\"strong\">is sounding</span> her horn to alert the dog in the middle of the road.</span>", "type": "text"}, {"content": " It <span class=\"strong\">sounds</span> like it's coming from inside the house.", "type": "example"}, {"content": " I <span class=\"strong\">think</span> you've got a family of squirrels who are residing up there.", "type": "example"}, {"content": "Squirrels <span class=\"strong\">have</span> front teeth that keep growing. ", "type": "example"}, {"content": "<span class=\"strong\">Do</span> you <span class=\"strong\">hear</span> that?", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "squirrel", "type": "name"}, {"content": "a small, bushy-tailed rodent that lives in trees and eats nuts", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I think you've got a family of squirrels who are residing up there. ", "type": "example"}, {"content": "engenn9le01ob07aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about household problems.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "scratching", "type": "name"}, {"content": "mark the surface of something with a sharp or pointed object", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Oh, that scratching sound?", "type": "example"}, {"content": "engenn9le01ob07aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to scrape", "type": "name"}, {"content": "to produce a harsh sound", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The tree outside is scraping against the house in the wind.", "type": "example"}, {"content": "engenn9le01ob07aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to freak someone out", "type": "name"}, {"content": "to shock or disorient someone", "type": "definition"}, {"content": "(expression) ", "type": "part_speech"}, {"content": "Example: You're freaking me out Peter! ", "type": "example"}, {"content": "engenn9le01ob07aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to do damage", "type": "name"}, {"content": "to destroy something", "type": "definition"}, {"content": "(expression) ", "type": "part_speech"}, {"content": "Example: Squirrels do a lot of damage.", "type": "example"}, {"content": "engenn9le01ob07aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "pest control", "type": "name"}, {"content": "the elimination or control of an insect or animal pest", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: Pest control can take care of it.", "type": "example"}, {"content": "engenn9le01ob07aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to gnaw", "type": "name"}, {"content": "to bite for a long time without stopping", "type": "definition"}, {"content": "(verb) ", "type": "part_speech"}, {"content": "Example: They will just keep gnawing at the roof so the problem will only get worse.", "type": "example"}, {"content": "engenn9le01ob07aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "catastrophe", "type": "name"}, {"content": "a sudden and widespread disaster", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: What a catastrophe!", "type": "example"}, {"content": "engenn9le01ob07aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "dramatic", "type": "name"}, {"content": "relating to theatrics", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: You are being a bit dramatic.", "type": "example"}, {"content": "engenn9le01ob07aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "construction", "type": "name"}, {"content": "the act, process of constructing", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: I will be staying with you while all this construction is going on.", "type": "example"}, {"content": "engenn9le01ob07aud10", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Go online and find out about an animal or insect that causes damage to people's homes. (You can watch a YouTube video, etc.)", "type": "text"}, {"content": "Find out the types of damage they do.", "type": "text"}, {"content": "Find out what needs to be done to remove them and fix the problem.", "type": "text"}, {"content": "Take notes about all the information you find.", "type": "text"}, {"content": "Share your information with a friend.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I research an animal that damages homes.", "type": "text"}, {"content": "I discover the type of damage they do.", "type": "text"}, {"content": "I find out what needs to be done to fix the problem.", "type": "text"}, {"content": "I write notes about the research I have done.", "type": "text"}, {"content": "I share my information with a friend.", "type": "text"}]}]}