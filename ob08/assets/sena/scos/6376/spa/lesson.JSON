ontents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le01ob08re2img05.jpg", "audiosrc": "engenn9le01ob08re2aud01", "images": [{"time": "0", "image": "engenn9le01ob08re2img05.jpg", "id": 0, "text": ""}, {"time": "20", "image": "engenn9le01ob08re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Sally</span>: Thanks for coming on such short notice.\n<br/><span class=\"strong\">Plumber</span>: You did sound a little panicked on the phone. You said something about a leak?\n<br/><span class=\"strong\">Sally</span>: More like a flood, actually. Last night, while my friend Vanessa was in the kitchen preparing dinner for us, I was taking a shower upstairs. Suddenly, water started gushing through the light fixture and onto the wood  and carpet. This needs to be fixed immediately!\n<br/><span class=\"strong\">Plumber</span>: Let's take a look. Yep, it looks as though the water is coming through the hole in the ceiling.\n<br/><span class=\"strong\">Sally</span>: Look at the floor. The deluge has stained the carpet and bowed the wood."}, {"time": "33000", "image": "engenn9le01ob08re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Plumber</span>: Do you need to use that bathroom upstairs for 24 hours? The walls need to be opened in the shower to work out how the water is escaping. There may be a problem with the grout.\n<br/><span class=\"strong\">Sally</span>: Really? I have some friends coming from out of town tomorrow morning.  The bathroom needs to be ready to use before they arrive.  24 hours would have been fine otherwise.\n<br/><span class=\"strong\">Plumber</span>: I'll have an electrician come and look at the wiring. Let me make a call. I'll also get my apprentice to leave another job and help."}, {"time": "62000", "image": "engenn9le01ob08re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>: Hopefully that does the trick.<br/><span class=\"strong\">Plumber</span>:  These hardwood floors need to be dried out as well.  I'll also have him bring our industrial heater.\n<br/><span class=\"strong\">Sally</span>: That would be great!\n<br/><span class=\"strong\">Plumber</span>: Before he arrives though, you will need to move all of the furniture away from the flooded area. Hopefully, this area might not need recarpeting.\n<br/><span class=\"strong\">Sally</span>: That would be great.\n<br/><span class=\"strong\">Plumber</span>: Alright, I need to run to my truck to grab my tools.\n<br/><span class=\"strong\">Sally</span>: I really appreciate it."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}, {"contents": [{"type": "video", "value": {"images": [{"time": "7000", "image": "", "id": 0, "text": "<span class=\"bullet\"> When do you use the passive infinitive?</span>"}, {"time": "29000", "image": "", "id": 1, "text": "<span class=\"bullet\">What are the different forms of the passive infinitive?</span>"}], "video_src": "engenn9le01ob08re3vid01"}}], "template_override": 1, "title": "", "type": "video", "id": 2, "_data": []}]}]}