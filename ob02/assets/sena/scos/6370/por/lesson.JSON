t_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"template_override": 1, "stimuli_ids": [], "questions": [{"responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn9le01ob02re7pdf01.pdf"}]}]}], "type": "DWS", "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Write a dialogue about a problem."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment."}]}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le01ob02re2img05.jpg", "audiosrc": "engenn9le01ob02re2aud01", "images": [{"time": "0", "image": "engenn9le01ob02re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn9le01ob02re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Sally</span>: Oops! Sorry Peter.\n<br/><span class=\"strong\">Peter</span>: Ouch! That's hot coffee!\n<br/><span class=\"strong\">Sally</span>: You'd better make sure it doesn't stain. It needs to be washed right away!\n<br/><span class=\"strong\">Vanessa</span>: That's a wool blend. Your shirt will need to be dry cleaned. It also looks like you spilled some over here. Wow! These  are nice hardwood floors. Are they pine or oak?"}, {"time": "21000", "image": "engenn9le01ob02re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Peter</span>: They're original, but I can't distinguish what type of wood they are.\n<br/><span class=\"strong\">Sally</span>:  These floors need waxing and polishing. Imagine how much sleeker they would look!  Entirely new floors need to be put in at my place.\n<br/><span class=\"strong\">Vanessa</span>: Your place could also do with a fresh coat of paint, Peter. These walls look like they have been neglected.\n<br/><span class=\"strong\">Peter</span>: The whole building has been forgotten. It was built in 1890 and then refurbished in 1925. Now it's like a time capsule from that era.\n<br/><span class=\"strong\">Vanessa</span>: I think the mouldings on the ceilings are definitely reminiscent of that time. How grand!\n<br/>"}, {"time": "55000", "image": "engenn9le01ob02re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>: You also have such a fantastic view but, yuck! These windows need some serious washing and then the view would be exceptional. Right now we are looking through a layer of grime.\n<br/><span class=\"strong\">Peter</span>: I might be able to have the floors done, but it's the landlord's responsibility to get the windows cleaned. Anyway, both of you spend so much time criticizing when you practically spend more time here than your own abodes. Now maybe we can clean up this spill!"}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}]}